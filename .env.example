# ---------------------------------------------------------------------------
# Web Push（VAPID）鍵。実値は .env（gitignore 済み）にだけ書く。
# 生成コマンド（出力された2行を .env に貼る。公開鍵は NEXT_PUBLIC_VAPID_PUBLIC_KEY にも同じ値を入れる）:
#   node --input-type=module -e 'const s=crypto.subtle;const p=await s.generateKey({name:"ECDSA",namedCurve:"P-256"},true,["sign"]);console.log("VAPID_PUBLIC_KEY="+Buffer.from(await s.exportKey("raw",p.publicKey)).toString("base64url"));console.log("VAPID_PRIVATE_KEY="+(await s.exportKey("jwk",p.privateKey)).d)'
# 本番（Cloudflare Workers）は次で投入する（本人確認後）:
#   npx wrangler secret put VAPID_PRIVATE_KEY
#   npx wrangler secret put VAPID_PUBLIC_KEY
#   npx wrangler secret put VAPID_SUBJECT
# ---------------------------------------------------------------------------
# raw 非圧縮公開鍵（65バイト）の base64url
VAPID_PUBLIC_KEY=
# クライアント用（/api/push/vapid-public-key が VAPID_PUBLIC_KEY 未設定時に参照）
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 秘密鍵 d（32バイト）の base64url
VAPID_PRIVATE_KEY=
# 連絡先（mailto: または https:）
VAPID_SUBJECT=

# 任意: データ JSON の配信元（未設定なら同梱の public/data/*.json）
# DATA_BASE_URL=

# ---------------------------------------------------------------------------
# 端末間同期（Cloudflare D1。wrangler.jsonc の d1_databases → binding SYNC_DB）。秘密の環境変数は不要。
# 同期キーは各端末の localStorage にだけあり、サーバー（D1）には SHA-256 だけを保存する。
# ローカル: npx wrangler d1 migrations apply apollo-ipo-sync --local
# 本番（本人確認後）: npx wrangler d1 migrations apply apollo-ipo-sync --remote
# ---------------------------------------------------------------------------
