{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apollo-ipo",
  // OpenNext の fetch を再利用しつつ Cron（scheduled）を足したカスタム worker。
  "main": "./worker/push-scheduled.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "apollo-ipo"
    }
  ],
  // プッシュ通知の購読情報。id は `npx wrangler kv namespace create PUSH_SUBSCRIPTIONS` で得た値に置き換える（本人確認後）。
  "kv_namespaces": [
    { "binding": "PUSH_SUBSCRIPTIONS", "id": "e8375f823321454b9327644a7b05f121" }
  ],
  // 端末間同期（同期キーの SHA-256 → JSON）。スキーマは migrations/。本番適用は
  // `npx wrangler d1 migrations apply apollo-ipo-sync --remote`（本人確認後）。
  "d1_databases": [
    {
      "binding": "SYNC_DB",
      "database_name": "apollo-ipo-sync",
      "database_id": "4fb3e1b9-193b-49e7-a480-fc59b6e3c6a2",
      "migrations_dir": "migrations"
    }
  ],
  // Cron（UTC）。処理の振り分けは worker/cron-jobs.ts の表（文字列を完全一致させる）。曜日は 1 = 日曜なので MON-FRI で書く。
  // - 0 23 * * *            : 毎日 08:00 JST の通知判定
  // - */10 0-6 * * MON-FRI  : 平日 09:00〜15:50 JST、当日上場銘柄の初値成立
  // - 45 6 * * MON-FRI      : 平日 15:45 JST、初値が付かなかった銘柄の即金規制の可能性
  // - 0 0-8 * * MON-FRI     : 平日 09:00〜17:00 JST の毎時、大量保有報告書の当日分を EDINET から取る
  "triggers": {
    "crons": ["0 23 * * *", "*/10 0-6 * * MON-FRI", "45 6 * * MON-FRI", "0 0-8 * * MON-FRI"]
  }
  // VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT は `npx wrangler secret put` で投入する（ファイルに平文で書かない）。
  // R2をISRキャッシュに使う場合のみ有効化（今回はStatic Assetsキャッシュ採用のため未使用）:
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "apollo-ipo-cache" }
  // ]
}
